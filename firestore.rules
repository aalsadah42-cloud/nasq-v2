rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function isManager(groupId) {
      return isMember(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role in ['owner', 'admin'];
    }

    function validParticipants(groupId, participantUids, participantNames) {
      let memberUids = get(groupPath(groupId)).data.memberUids;
      return participantUids is list
        && participantUids.size() > 0
        && participantUids.size() <= 30
        && participantUids.size() == memberUids.size()
        && participantUids.hasAll(memberUids)
        && memberUids.hasAll(participantUids)
        && participantNames is map
        && participantNames.keys().size() == participantUids.size()
        && participantNames.keys().hasAll(participantUids);
    }

    function validMemberListAddition(groupId) {
      let memberUid = request.resource.data.memberCountChangeUid;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCountChangeUid'])
        && resource.data.memberUids is list
        && request.resource.data.memberUids is list
        && memberUid is string
        && memberUid == request.auth.uid
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.size() <= 30
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.hasAll([memberUid])
        && !resource.data.memberUids.hasAny([memberUid])
        && !exists(memberPath(groupId, memberUid))
        && existsAfter(memberPath(groupId, memberUid));
    }

    function validMemberListRemoval(groupId) {
      let memberUid = request.resource.data.memberCountChangeUid;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCountChangeUid'])
        && resource.data.memberUids is list
        && request.resource.data.memberUids is list
        && memberUid is string
        && (
          isManager(groupId)
          || memberUid == request.auth.uid
        )
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && resource.data.memberUids.hasAll([memberUid])
        && !request.resource.data.memberUids.hasAny([memberUid])
        && get(memberPath(groupId, memberUid)).data.role != 'owner'
        && !existsAfter(memberPath(groupId, memberUid));
    }

    function validSelfGatheringDecision(groupId) {
      let before = resource.data.get('participantDecisionsByUid', {});
      let after = request.resource.data.get('participantDecisionsByUid', {});
      let changed = after.diff(before).affectedKeys();
      return isMember(groupId)
        && before is map
        && after is map
        && changed.hasOnly([request.auth.uid])
        && changed.hasAny([request.auth.uid])
        && after.get(request.auth.uid, null) in ['joined', 'declined'];
    }

    function validSelfGatheringExpense(groupId) {
      let before = resource.data.get('expensesByUid', {});
      let after = request.resource.data.get('expensesByUid', {});
      let changed = after.diff(before).affectedKeys();
      let oldExpenses = before.get(request.auth.uid, []);
      let newExpenses = after.get(request.auth.uid, []);
      let expense = newExpenses[newExpenses.size() - 1];
      return isMember(groupId)
        && before is map
        && after is map
        && changed.hasOnly([request.auth.uid])
        && changed.hasAny([request.auth.uid])
        && oldExpenses is list
        && newExpenses is list
        && newExpenses.size() == oldExpenses.size() + 1
        && newExpenses.hasAll(oldExpenses)
        && expense is map
        && expense.keys().hasOnly(['id', 'description', 'payer', 'amount'])
        && expense.id is number
        && expense.description is string
        && expense.description.size() > 0
        && expense.payer is string
        && expense.payer.size() > 0
        && expense.amount is number
        && expense.amount > 0;
    }

    function validSelfGatheringTaskClaim(groupId) {
      let before = resource.data.get('taskClaimsByUid', {});
      let after = request.resource.data.get('taskClaimsByUid', {});
      let changed = after.diff(before).affectedKeys();
      let oldTaskIds = before.get(request.auth.uid, []);
      let newTaskIds = after.get(request.auth.uid, []);
      return isMember(groupId)
        && before is map
        && after is map
        && changed.hasOnly([request.auth.uid])
        && changed.hasAny([request.auth.uid])
        && oldTaskIds is list
        && newTaskIds is list
        && newTaskIds.size() == oldTaskIds.size() + 1
        && newTaskIds.hasAll(oldTaskIds)
        && newTaskIds[newTaskIds.size() - 1] is number;
    }

    function validGatheringMemberUpdate(groupId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'participantDecisionsByUid',
          'expensesByUid',
          'taskClaimsByUid'
        ])
        && (
          !changed.hasAny(['participantDecisionsByUid'])
          || validSelfGatheringDecision(groupId)
        )
        && (
          !changed.hasAny(['expensesByUid'])
          || validSelfGatheringExpense(groupId)
        )
        && (
          !changed.hasAny(['taskClaimsByUid'])
          || validSelfGatheringTaskClaim(groupId)
        );
    }

    function isGatheringParticipant() {
      return signedIn()
        && resource.data.participantUids is list
        && resource.data.participantUids.hasAll([request.auth.uid]);
    }

    function validStandaloneGatheringParticipantUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get('participantDecisionsByUid', {});
      let after = request.resource.data.get('participantDecisionsByUid', {});
      let decisionKeys = after.diff(before).affectedKeys();
      return isGatheringParticipant()
        && changed.hasOnly(['participantDecisionsByUid'])
        && before is map
        && after is map
        && decisionKeys.hasOnly([request.auth.uid])
        && decisionKeys.hasAny([request.auth.uid])
        && after.get(request.auth.uid, null) in ['joined', 'declined'];
    }

    function validStandaloneGatheringExpenseUpdate() {
      let before = resource.data.get('expensesByUid', {});
      let after = request.resource.data.get('expensesByUid', {});
      let changed = after.diff(before).affectedKeys();
      let oldExpenses = before.get(request.auth.uid, []);
      let newExpenses = after.get(request.auth.uid, []);
      let expense = newExpenses[newExpenses.size() - 1];
      return isGatheringParticipant()
        && before is map
        && after is map
        && changed.hasOnly([request.auth.uid])
        && changed.hasAny([request.auth.uid])
        && oldExpenses is list
        && newExpenses is list
        && newExpenses.size() == oldExpenses.size() + 1
        && newExpenses.hasAll(oldExpenses)
        && expense is map
        && expense.keys().hasOnly(['id', 'description', 'payer', 'amount'])
        && expense.id is number
        && expense.description is string
        && expense.description.size() > 0
        && expense.payer is string
        && expense.payer.size() > 0
        && expense.amount is number
        && expense.amount > 0;
    }

    function validStandaloneGatheringTaskClaimUpdate() {
      let before = resource.data.get('taskClaimsByUid', {});
      let after = request.resource.data.get('taskClaimsByUid', {});
      let changed = after.diff(before).affectedKeys();
      let oldTaskIds = before.get(request.auth.uid, []);
      let newTaskIds = after.get(request.auth.uid, []);
      return isGatheringParticipant()
        && before is map
        && after is map
        && changed.hasOnly([request.auth.uid])
        && changed.hasAny([request.auth.uid])
        && oldTaskIds is list
        && newTaskIds is list
        && newTaskIds.size() == oldTaskIds.size() + 1
        && newTaskIds.hasAll(oldTaskIds)
        && newTaskIds[newTaskIds.size() - 1] is number;
    }

    function validStandaloneGatheringMemberUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'participantDecisionsByUid',
          'expensesByUid',
          'taskClaimsByUid'
        ])
        && (
          !changed.hasAny(['participantDecisionsByUid'])
          || validStandaloneGatheringParticipantUpdate()
        )
        && (
          !changed.hasAny(['expensesByUid'])
          || validStandaloneGatheringExpenseUpdate()
        )
        && (
          !changed.hasAny(['taskClaimsByUid'])
          || validStandaloneGatheringTaskClaimUpdate()
        );
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /gatherings/{gatheringId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/gatherings/$(gatheringId))
          || isGatheringParticipant()
          || resource.data.createdById == request.auth.uid);
      allow list: if isGatheringParticipant();
      allow create: if signedIn()
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() > 0
        && request.resource.data.participantUids.size() <= 30
        && request.resource.data.participantUids.hasAll([request.auth.uid])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == request.resource.data.participantUids.size();
      allow update: if (
        signedIn()
        && resource.data.createdById == request.auth.uid
        && request.resource.data.createdById == resource.data.createdById
      ) || validStandaloneGatheringMemberUpdate();
      allow delete: if signedIn() && resource.data.createdById == request.auth.uid;
    }

    match /billSplits/{splitId} {
      allow get, list: if signedIn()
        && resource.data.participantUids is list
        && resource.data.participantUids.hasAll([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() > 0
        && request.resource.data.participantUids.size() <= 30
        && request.resource.data.participantUids.hasAll([request.auth.uid])
        && request.resource.data.participantNames is map
        && request.resource.data.participantNames.keys().size() == request.resource.data.participantUids.size()
        && request.resource.data.participantNames.keys().hasAll(request.resource.data.participantUids)
        && request.resource.data.sharesByUid is map
        && request.resource.data.sharesByUid.keys().size() == request.resource.data.participantUids.size()
        && request.resource.data.sharesByUid.keys().hasAll(request.resource.data.participantUids)
        && request.resource.data.paymentStatuses is map
        && request.resource.data.paymentStatuses.keys().size() == request.resource.data.participantUids.size()
        && request.resource.data.paymentStatuses.keys().hasAll(request.resource.data.participantUids);
      allow update: if (
        signedIn()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatuses'])
        && request.resource.data.paymentStatuses is map
        && request.resource.data.paymentStatuses.keys().hasAll(resource.data.participantUids)
      ) || (
        signedIn()
        && resource.data.participantUids.hasAll([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatuses'])
        && resource.data.paymentStatuses is map
        && request.resource.data.paymentStatuses is map
        && request.resource.data.paymentStatuses.diff(resource.data.paymentStatuses).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.paymentStatuses.diff(resource.data.paymentStatuses).affectedKeys().hasAny([request.auth.uid])
        && resource.data.paymentStatuses.get(request.auth.uid, null) == 'pending'
        && request.resource.data.paymentStatuses.get(request.auth.uid, null) == 'awaiting'
      );
      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && isMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1
        && !exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid;
      allow update: if signedIn() && (
        (
          isManager(resource.data.groupId)
          && request.resource.data.groupId == resource.data.groupId
          && request.resource.data.memberCount == resource.data.memberCount
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberCountChangeUid'])
          && request.resource.data.memberCount is int
          && resource.data.memberCount is int
          && request.resource.data.memberCountChangeUid is string
          && (
            (
              request.resource.data.memberCount == resource.data.memberCount + 1
              && request.resource.data.memberCount <= 30
              && !exists(memberPath(resource.data.groupId, request.resource.data.memberCountChangeUid))
              && existsAfter(memberPath(resource.data.groupId, request.resource.data.memberCountChangeUid))
            )
            || (
              request.resource.data.memberCount == resource.data.memberCount - 1
              && request.resource.data.memberCount >= 1
              && exists(memberPath(resource.data.groupId, request.resource.data.memberCountChangeUid))
              && !existsAfter(memberPath(resource.data.groupId, request.resource.data.memberCountChangeUid))
            )
          )
        )
      );
      allow delete: if signedIn() && isManager(resource.data.groupId);
    }

    match /groups/{groupId} {
      allow get: if isMember(groupId);
      allow list: if isMember(groupId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.get('hasFund', true) is bool;
      allow update: if (
        isManager(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (
          request.resource.data.createdBy == resource.data.createdBy
          || (
            get(memberPath(groupId, request.auth.uid)).data.role == 'owner'
            && request.resource.data.createdBy is string
            && getAfter(memberPath(groupId, request.resource.data.createdBy)).data.role == 'owner'
            && getAfter(memberPath(groupId, request.auth.uid)).data.role == 'admin'
          )
        )
      ) || (
        signedIn()
        && validMemberListAddition(groupId)
      ) || (
        signedIn()
        && validMemberListRemoval(groupId)
      ) || (
        isManager(groupId)
        && resource.data.get('hasFund', true) == false
        && request.resource.data.hasFund == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasFund'])
      );
      allow delete: if isManager(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role == 'owner';

      match /members/{memberUid} {
        allow read: if isMember(groupId) || (signedIn() && memberUid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.uid == memberUid
          && memberUid == request.auth.uid
          && (
            (request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
              && getAfter(groupPath(groupId)).data.memberUids.hasAll([memberUid])
              && getAfter(groupPath(groupId)).data.memberUids.size() == 1
            )
            || (request.resource.data.role == 'member'
              && request.resource.data.joinedViaInviteCode is string
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaInviteCode)).data.groupId == groupId
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaInviteCode)).data.memberCount < 30
              && getAfter(groupPath(groupId)).data.memberUids.size() <= 30
              && getAfter(groupPath(groupId)).data.memberUids.hasAll([memberUid])
              && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaInviteCode)).data.memberCount
                == get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaInviteCode)).data.memberCount + 1
              && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaInviteCode)).data.memberCountChangeUid == memberUid)
          );
        allow update: if (
          isManager(groupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'displayName'])
          && (
            request.resource.data.role == resource.data.role
            || (
              resource.data.role != 'owner'
              && request.resource.data.role in ['member', 'admin']
              && (
                get(memberPath(groupId, request.auth.uid)).data.role == 'owner'
                || request.resource.data.role == 'member'
              )
            )
            || (
              resource.data.role == 'owner'
              && memberUid == request.auth.uid
              && request.resource.data.role == 'admin'
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy != request.auth.uid
              && getAfter(memberPath(
                groupId,
                getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
              )).data.role == 'owner'
            )
            || (
              resource.data.role != 'owner'
              && request.resource.data.role == 'owner'
              && get(memberPath(groupId, request.auth.uid)).data.role == 'owner'
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == memberUid
              && getAfter(memberPath(groupId, request.auth.uid)).data.role == 'admin'
            )
          )
        ) || (
          signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        );
        allow delete: if (
          (isManager(groupId) || (signedIn() && memberUid == request.auth.uid))
          && resource.data.role != 'owner'
          && resource.data.joinedViaInviteCode is string
          && get(groupPath(groupId)).data.memberUids.hasAll([memberUid])
          && !getAfter(groupPath(groupId)).data.memberUids.hasAny([memberUid])
          && get(/databases/$(database)/documents/inviteCodes/$(resource.data.joinedViaInviteCode)).data.memberCount
            == getAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.joinedViaInviteCode)).data.memberCount + 1
          && getAfter(/databases/$(database)/documents/inviteCodes/$(resource.data.joinedViaInviteCode)).data.memberCountChangeUid == memberUid
        ) || (
          signedIn() && memberUid == request.auth.uid && resource.data.role != 'owner'
        ) || (
          signedIn()
          && memberUid == request.auth.uid
          && resource.data.role == 'owner'
          && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/groups/$(groupId))
        );
      }

      match /transactions/{transactionId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasAll([
            'id', 'workspaceId', 'title', 'cadence', 'total', 'due', 'participantUids', 'participantNames', 'createdBy'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'workspaceId', 'title', 'cadence', 'total', 'due', 'participantUids', 'participantNames', 'createdBy'
          ])
          && request.resource.data.id is number
          && request.resource.data.workspaceId == groupId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.cadence is string
          && request.resource.data.due is string
          && request.resource.data.total is number
          && request.resource.data.total > 0
          && validParticipants(groupId, request.resource.data.participantUids, request.resource.data.participantNames);
        allow update, delete: if isManager(groupId);

        match /confirmations/{memberUid} {
          allow read: if isMember(groupId);
          allow create: if isMember(groupId)
            && exists(/databases/$(database)/documents/groups/$(groupId)/transactions/$(transactionId))
            && memberUid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'awaiting'
            && request.resource.data.confirmedAt == request.time;
          allow update: if false;
          allow delete: if isManager(groupId);
        }
      }

      match /fund/{fundId} {
        allow read: if isMember(groupId);
        allow create: if isManager(groupId) || (
          signedIn()
          && request.resource.data.groupId == groupId
          && request.resource.data.balance == 0
          && getAfter(groupPath(groupId)).data.createdBy == request.auth.uid
          && getAfter(groupPath(groupId)).data.hasFund == true
          && getAfter(memberPath(groupId, request.auth.uid)).data.role == 'owner'
        );
        allow update, delete: if isManager(groupId);
      }

      match /obligations/{obligationId} {
        allow read: if isMember(groupId);
        allow create: if isManager(groupId)
          && request.resource.data.workspaceId == groupId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status == 'upcoming';
        allow update: if (
          isManager(groupId)
          && request.resource.data.status == 'paid'
          && resource.data.status in ['awaiting', 'paid']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt'])
        ) || (
          isMember(groupId)
          && resource.data.status in ['upcoming', 'due']
          && request.resource.data.status == 'awaiting'
          && request.resource.data.reportedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reportedByUid', 'reportedAt'])
        );
        allow delete: if isManager(groupId);
      }

      match /reimbursements/{reimbursementId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.workspaceId == groupId
          && request.resource.data.memberUid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status == 'review';
        allow update: if (
          isManager(groupId)
          && (
            (resource.data.status == 'review'
              && request.resource.data.status in ['awaiting-receipt', 'rejected'])
            || (resource.data.status == 'awaiting-receipt'
              && request.resource.data.status == 'awaiting-receipt')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        ) || (
          isMember(groupId)
          && resource.data.memberUid == request.auth.uid
          && resource.data.status == 'awaiting-receipt'
          && request.resource.data.status in ['received', 'objection']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedAt'])
        );
        allow delete: if isManager(groupId);
      }

      match /gatherings/{gatheringId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.createdById == request.auth.uid;
        allow update: if isMember(groupId)
          && request.resource.data.createdById == resource.data.createdById
          && (resource.data.createdById == request.auth.uid || validGatheringMemberUpdate(groupId));
        allow delete: if isMember(groupId) && resource.data.createdById == request.auth.uid;
      }
    }

    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}