rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function isMember(groupId) {
      return signedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function isManager(groupId) {
      return isMember(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role in ['owner', 'admin'];
    }

    function validContribution(groupId, contribution) {
      return contribution is map
        && contribution.keys().hasAll(['uid', 'name', 'amount', 'status'])
        && contribution.keys().hasOnly(['uid', 'name', 'amount', 'status'])
        && contribution.uid is string
        && contribution.name is string
        && contribution.name.size() > 0
        && contribution.amount is number
        && contribution.amount > 0
        && contribution.status == 'unpaid'
        && exists(memberPath(groupId, contribution.uid));
    }

    function validContributionAt(groupId, contributions, index) {
      return contributions.size() <= index
        || validContribution(groupId, contributions[index]);
    }

    function contributionAmountAt(contributions, index) {
      return contributions.size() > index ? contributions[index].amount : 0;
    }

    function validContributions(groupId, contributions, total) {
      let sum = contributionAmountAt(contributions, 0)
        + contributionAmountAt(contributions, 1)
        + contributionAmountAt(contributions, 2)
        + contributionAmountAt(contributions, 3)
        + contributionAmountAt(contributions, 4)
        + contributionAmountAt(contributions, 5)
        + contributionAmountAt(contributions, 6)
        + contributionAmountAt(contributions, 7)
        + contributionAmountAt(contributions, 8)
        + contributionAmountAt(contributions, 9)
        + contributionAmountAt(contributions, 10)
        + contributionAmountAt(contributions, 11)
        + contributionAmountAt(contributions, 12)
        + contributionAmountAt(contributions, 13)
        + contributionAmountAt(contributions, 14)
        + contributionAmountAt(contributions, 15)
        + contributionAmountAt(contributions, 16)
        + contributionAmountAt(contributions, 17)
        + contributionAmountAt(contributions, 18)
        + contributionAmountAt(contributions, 19)
        + contributionAmountAt(contributions, 20)
        + contributionAmountAt(contributions, 21)
        + contributionAmountAt(contributions, 22)
        + contributionAmountAt(contributions, 23)
        + contributionAmountAt(contributions, 24)
        + contributionAmountAt(contributions, 25)
        + contributionAmountAt(contributions, 26)
        + contributionAmountAt(contributions, 27)
        + contributionAmountAt(contributions, 28)
        + contributionAmountAt(contributions, 29);
      return contributions is list
        && contributions.size() > 0
        && contributions.size() <= 30
        && validContributionAt(groupId, contributions, 0)
        && validContributionAt(groupId, contributions, 1)
        && validContributionAt(groupId, contributions, 2)
        && validContributionAt(groupId, contributions, 3)
        && validContributionAt(groupId, contributions, 4)
        && validContributionAt(groupId, contributions, 5)
        && validContributionAt(groupId, contributions, 6)
        && validContributionAt(groupId, contributions, 7)
        && validContributionAt(groupId, contributions, 8)
        && validContributionAt(groupId, contributions, 9)
        && validContributionAt(groupId, contributions, 10)
        && validContributionAt(groupId, contributions, 11)
        && validContributionAt(groupId, contributions, 12)
        && validContributionAt(groupId, contributions, 13)
        && validContributionAt(groupId, contributions, 14)
        && validContributionAt(groupId, contributions, 15)
        && validContributionAt(groupId, contributions, 16)
        && validContributionAt(groupId, contributions, 17)
        && validContributionAt(groupId, contributions, 18)
        && validContributionAt(groupId, contributions, 19)
        && validContributionAt(groupId, contributions, 20)
        && validContributionAt(groupId, contributions, 21)
        && validContributionAt(groupId, contributions, 22)
        && validContributionAt(groupId, contributions, 23)
        && validContributionAt(groupId, contributions, 24)
        && validContributionAt(groupId, contributions, 25)
        && validContributionAt(groupId, contributions, 26)
        && validContributionAt(groupId, contributions, 27)
        && validContributionAt(groupId, contributions, 28)
        && validContributionAt(groupId, contributions, 29)
        && sum >= total - 0.001
        && sum <= total + 0.001;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && isMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && isManager(resource.data.groupId);
    }

    match /groups/{groupId} {
      allow get: if isMember(groupId);
      allow list: if isMember(groupId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if isManager(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (
          request.resource.data.createdBy == resource.data.createdBy
          || (
            get(memberPath(groupId, request.auth.uid)).data.role == 'owner'
            && request.resource.data.createdBy is string
            && getAfter(memberPath(groupId, request.resource.data.createdBy)).data.role == 'owner'
            && getAfter(memberPath(groupId, request.auth.uid)).data.role == 'admin'
          )
        );
      allow delete: if isManager(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role == 'owner';

      match /members/{memberUid} {
        allow read: if isMember(groupId) || (signedIn() && memberUid == request.auth.uid);
        allow create: if signedIn()
          && request.resource.data.uid == memberUid
          && memberUid == request.auth.uid
          && (
            (request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
            || (request.resource.data.role == 'member'
              && request.resource.data.joinedViaInviteCode is string
              && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinedViaInviteCode)).data.groupId == groupId)
          );
        allow update: if (
          isManager(groupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'displayName'])
          && (
            request.resource.data.role == resource.data.role
            || (
              resource.data.role != 'owner'
              && request.resource.data.role in ['member', 'admin']
              && (
                get(memberPath(groupId, request.auth.uid)).data.role == 'owner'
                || request.resource.data.role == 'member'
              )
            )
            || (
              resource.data.role == 'owner'
              && memberUid == request.auth.uid
              && request.resource.data.role == 'admin'
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy != request.auth.uid
              && getAfter(memberPath(
                groupId,
                getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
              )).data.role == 'owner'
            )
            || (
              resource.data.role != 'owner'
              && request.resource.data.role == 'owner'
              && get(memberPath(groupId, request.auth.uid)).data.role == 'owner'
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == memberUid
              && getAfter(memberPath(groupId, request.auth.uid)).data.role == 'admin'
            )
          )
        ) || (
          signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        );
        allow delete: if (
          isManager(groupId) && resource.data.role != 'owner'
        ) || (
          signedIn() && memberUid == request.auth.uid && resource.data.role != 'owner'
        ) || (
          signedIn()
          && memberUid == request.auth.uid
          && resource.data.role == 'owner'
          && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/groups/$(groupId))
        );
      }

      match /transactions/{transactionId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.keys().hasAll([
            'id', 'workspaceId', 'title', 'cadence', 'total', 'due', 'contributions', 'createdBy'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'workspaceId', 'title', 'cadence', 'total', 'due', 'contributions', 'createdBy'
          ])
          && request.resource.data.id is number
          && request.resource.data.workspaceId == groupId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.cadence is string
          && request.resource.data.due is string
          && request.resource.data.total is number
          && request.resource.data.total > 0
          && validContributions(groupId, request.resource.data.contributions, request.resource.data.total);
        allow update, delete: if isManager(groupId);

        match /confirmations/{memberUid} {
          allow read: if isMember(groupId);
          allow create: if isMember(groupId)
            && exists(/databases/$(database)/documents/groups/$(groupId)/transactions/$(transactionId))
            && memberUid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'awaiting'
            && request.resource.data.confirmedAt == request.time;
          allow update: if false;
          allow delete: if isManager(groupId);
        }
      }

      match /fund/{fundId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isManager(groupId);
      }

      match /obligations/{obligationId} {
        allow read: if isMember(groupId);
        allow create: if isManager(groupId)
          && request.resource.data.workspaceId == groupId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status == 'upcoming';
        allow update: if (
          isManager(groupId)
          && request.resource.data.status == 'paid'
          && resource.data.status in ['awaiting', 'paid']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt'])
        ) || (
          isMember(groupId)
          && resource.data.status in ['upcoming', 'due']
          && request.resource.data.status == 'awaiting'
          && request.resource.data.reportedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reportedByUid', 'reportedAt'])
        );
        allow delete: if isManager(groupId);
      }

      match /reimbursements/{reimbursementId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.workspaceId == groupId
          && request.resource.data.memberUid == request.auth.uid
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.status == 'review';
        allow update: if (
          isManager(groupId)
          && (
            (resource.data.status == 'review'
              && request.resource.data.status in ['awaiting-receipt', 'rejected'])
            || (resource.data.status == 'awaiting-receipt'
              && request.resource.data.status == 'awaiting-receipt')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        ) || (
          isMember(groupId)
          && resource.data.memberUid == request.auth.uid
          && resource.data.status == 'awaiting-receipt'
          && request.resource.data.status in ['received', 'objection']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedAt'])
        );
        allow delete: if isManager(groupId);
      }

      match /gatherings/{gatheringId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.createdById == request.auth.uid;
        allow update: if isMember(groupId)
          && request.resource.data.createdById == resource.data.createdById
          && (
            resource.data.createdById == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['id', 'participants', 'attendees', 'expenses', 'tasks', 'total'])
          );
        allow delete: if isMember(groupId) && resource.data.createdById == request.auth.uid;
      }
    }

    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}